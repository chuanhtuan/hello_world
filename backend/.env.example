# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (MySQL / RDS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hello_world
DB_USER=hello_world
DB_PASSWORD=changeme

# JWT ("Remember me" unchecked uses the default TTL + a session cookie;
# checked uses the "remember" TTL + a 30-day cookie - see utils/session.ts)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN_DEFAULT=1d
JWT_EXPIRES_IN_REMEMBER=30d
COOKIE_NAME=hw_token

# SMTP (activation + forgot-password emails) - e.g. Gmail SMTP or SendGrid SMTP relay
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="HelloWorld <no-reply@helloworld.com>"

# Google Sign-In (Google Identity Services). Create an OAuth 2.0 Client ID
# of type "Web application" in Google Cloud Console > APIs & Services >
# Credentials, add your frontend origin(s) (e.g. http://localhost:5173)
# under "Authorized JavaScript origins", and paste the Client ID below.
# Only the Client ID is needed here - the frontend sends an ID token that
# the backend verifies directly with Google (no client secret required).
GOOGLE_CLIENT_ID=

# AWS S3 (avatar storage)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=hello-world-avatars-610734023706
# Leave AWS_ACCESS_KEY_ID/SECRET empty when running on EC2 with an IAM instance role attached.
